<?xml version="1.0"?>
<alloy>

<view nodetheme="Martha">

<defaultnode/>

<defaultedge/>

<node>
   <type name="Int"/>
   <type name="String"/>
   <type name="univ"/>
   <type name="lsts/Init"/>
   <type name="lsts/State"/>
   <type name="seq/Int"/>
</node>

<node color="White">
   <type name="lsts/lsts/Path"/>
</node>

<node color="White" label="t">
   <type name="lsts/lsts/Transition"/>
</node>

<node shape="Ellipse" color="Gray">
   <type name="lsts/lsts/AState"/>
</node>

<node visible="no">
   <type name="lsts/Action"/>
   <type name="lsts/AP"/>
   <type name="lsts/epsilon"/>
</node>

<edge attribute="yes">
   <relation name="r"> <type name="lsts/lsts/AState"/> <type name="lsts/Action"/> </relation>
</edge>

<edge color="Black">
   <relation name="dest"> <type name="lsts/lsts/Transition"/> <type name="lsts/lsts/AState"/> </relation>
</edge>

<edge color="Black" layout="yes">
   <relation name="src"> <type name="lsts/lsts/Transition"/> <type name="lsts/lsts/AState"/> </relation>
</edge>

<edge visible="no" attribute="yes">
   <relation name="end"> <type name="lsts/lsts/Path"/> <type name="lsts/lsts/AState"/> </relation>
   <relation name="label"> <type name="lsts/lsts/AState"/> <type name="lsts/AP"/> </relation>
   <relation name="label"> <type name="lsts/lsts/Transition"/> <type name="lsts/Action"/> </relation>
   <relation name="start"> <type name="lsts/lsts/Path"/> <type name="lsts/lsts/AState"/> </relation>
   <relation name="tr"> <type name="lsts/lsts/Path"/> <type name="seq/Int"/> <type name="lsts/lsts/Transition"/> </relation>
</edge>

</view>

</alloy>
